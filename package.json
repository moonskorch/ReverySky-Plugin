{
  "name": "reverysky-obsidian-plugin",
  "version": "0.0.1",
  "private": true,
  "description": "ReverySky Map Obsidian plugin",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "check:unity-webgl": "node scripts/check-unity-webgl-artifacts.mjs",
    "build": "npm run check:unity-webgl && tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "esbuild": "^0.28.0",
    "jsdom": "^26.1.0",
    "obsidian": "^1.8.10",
    "typescript": "^5.6.2",
    "vitest": "^4.1.7"
  }
}
